# Expiry Date Manager - Express Server Environment Configurations

# The port the Express server will run on (Default: 5001)
PORT=5001

# MongoDB Connection URI
# Local Development: mongodb://localhost:27017/expiry-date-manager
# Production: Your MongoDB Atlas connection string (e.g. mongodb+srv://username:password@cluster.mongodb.net/dbname)
MONGODB_URI=mongodb://localhost:27017/expiry-date-manager

# Secret key used for signing JWT authentication tokens
JWT_SECRET=27f9103f-2cd7-4118-9a48-de37eacfa095

# The URL of the frontend client allowed to make cross-origin requests
# Local Development: http://localhost:5173
# Production: Your Netlify URL (e.g., https://your-app-name.netlify.app)
CLIENT_URL=http://localhost:5173

# Node environment (development or production)
# Set to 'production' when deploying to Render so secure cross-origin cookies are enabled
NODE_ENV=development
